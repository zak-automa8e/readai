{
  "$description": "Narwi · نروي design tokens — palette Illuminated (brand story 3, approved 2026-10-16). W3C Design Tokens format; import into Figma with Tokens Studio. Same values as tokens.css.",
  "color": {
    "light": {
      "bg":          { "$type": "color", "$value": "#F7F5EF", "$description": "Background — paper" },
      "surface":     { "$type": "color", "$value": "#FFFFFF", "$description": "Cards, panels, the book page" },
      "text":        { "$type": "color", "$value": "#161A2B", "$description": "Text — oak-gall ink" },
      "muted":       { "$type": "color", "$value": "#565B6E", "$description": "Secondary text" },
      "line":        { "$type": "color", "$value": "#E2E0D8", "$description": "Hairline borders" },
      "primary":     { "$type": "color", "$value": "#1E3A8A", "$description": "Lapis — carries the brand" },
      "on-primary":  { "$type": "color", "$value": "#FFFFFF", "$description": "Text on lapis" },
      "accent":      { "$type": "color", "$value": "#B4322A", "$description": "Red ink — marks what is being read" },
      "accent-soft": { "$type": "color", "$value": "#F7E3DF", "$description": "Highlight behind the passage being read" },
      "deco":        { "$type": "color", "$value": "#B8892B", "$description": "Gold — ornament only, never text" }
    },
    "dark": {
      "bg":          { "$type": "color", "$value": "#0D1124", "$description": "Background — night" },
      "surface":     { "$type": "color", "$value": "#151A30", "$description": "Cards, panels, the book page" },
      "text":        { "$type": "color", "$value": "#ECE9E1", "$description": "Text" },
      "muted":       { "$type": "color", "$value": "#A0A4B5", "$description": "Secondary text" },
      "line":        { "$type": "color", "$value": "#262B44", "$description": "Hairline borders" },
      "primary":     { "$type": "color", "$value": "#8DA6F2", "$description": "Lapis, lifted for night" },
      "on-primary":  { "$type": "color", "$value": "#0D1124", "$description": "Text on lapis" },
      "accent":      { "$type": "color", "$value": "#EE7B66", "$description": "Red ink, lifted for night" },
      "accent-soft": { "$type": "color", "$value": "#3A2230", "$description": "Highlight behind the passage being read" },
      "deco":        { "$type": "color", "$value": "#D9AE4F", "$description": "Gold — ornament only, never text" }
    }
  },
  "font": {
    "arabic": { "$type": "fontFamily", "$value": ["Amiri", "serif"], "$description": "Arabic display and the book text. Weights 400, 700." },
    "latin":  { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "serif"], "$description": "Latin display. Weight 600 (the wordmark uses 600 at optical size 72)." },
    "ui":     { "$type": "fontFamily", "$value": ["Readex Pro", "system-ui", "sans-serif"], "$description": "Interface, both scripts. Weights 300–600." },
    "book":   { "$type": "fontFamily", "$value": ["Amiri", "serif"], "$description": "Book text, whatever the interface does." }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "6px" }
  }
}
